  "patterns": [
    {
      "pattern": "^(\\d+) files? changed$",
      "replace": "已變更 $1 個檔案"
    },
    {
      "pattern": "^Step (\\d+) of (\\d+)$",
      "replace": "步驟 $1 / $2"
    },
    {
      "pattern": "^(\\d+) seconds? ago$",
      "replace": "$1 秒前"
    },
    {
      "pattern": "^(\\d+) minutes? ago$",
      "replace": "$1 分鐘前"
    },
    {
      "pattern": "^(\\d+) hours? ago$",
      "replace": "$1 小時前"
    },
    {
      "pattern": "^(\\d+) days? ago$",
      "replace": "$1 天前"
    },
    {
      "pattern": "^Updated (.+)$",
      "replace": "更新於 $1"
    },
    {
      "pattern": "^Running (.+)\\.\\.\\.$",
      "replace": "正在執行 $1⋯"
    },
    {
      "pattern": "^Search (.+)\\.\\.\\.$",
      "replace": "搜尋 $1⋯"
    },
    {
      "pattern": "^(\\d+) tasks? remaining$",
      "replace": "尚餘 $1 項任務"
    },
    {
      "pattern": "^(\\d+) active agents?$",
      "replace": "$1 個執行中代理"
    },
    {
      "pattern": "^(\\d+) selected$",
      "replace": "已選取 $1 項"
    }
  ]
