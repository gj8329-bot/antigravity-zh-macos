  "patterns": [
    {
      "pattern": "^(\\d+) files? changed$",
      "replace": "已更改 $1 个文件"
    },
    {
      "pattern": "^Step (\\d+) of (\\d+)$",
      "replace": "步骤 $1 / $2"
    },
    {
      "pattern": "^(\\d+) seconds? ago$",
      "replace": "$1 秒前"
    },
    {
      "pattern": "^(\\d+) minutes? ago$",
      "replace": "$1 分钟前"
    },
    {
      "pattern": "^(\\d+) hours? ago$",
      "replace": "$1 小时前"
    },
    {
      "pattern": "^(\\d+) days? ago$",
      "replace": "$1 天前"
    },
    {
      "pattern": "^Updated (.+)$",
      "replace": "更新于 $1"
    },
    {
      "pattern": "^Running (.+)\\.\\.\\.$",
      "replace": "正在运行 $1..."
    },
    {
      "pattern": "^Search (.+)\\.\\.\\.$",
      "replace": "搜索 $1..."
    },
    {
      "pattern": "^(\\d+) tasks? remaining$",
      "replace": "剩余 $1 项任务"
    },
    {
      "pattern": "^(\\d+) active agents?$",
      "replace": "$1 个运行中智能体"
    },
    {
      "pattern": "^(\\d+) selected$",
      "replace": "已选择 $1 项"
    }
  ]
